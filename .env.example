# Database connection string
# Local development without PostgreSQL: DATABASE_URL=sqlite:///./cobudget.db
DATABASE_URL=postgresql://user:password@localhost:5432/cobudget

# JWT signing key — generate a long random string for production
SECRET_KEY=change-me-to-a-random-string

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Budget invite links
INVITE_TOKEN_EXPIRE_DAYS=7
